{
  "name": "nico-notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nico-notes/backend --filter @nico-notes/mobile --parallel dev",
    "dev:mobile": "pnpm --filter @nico-notes/mobile dev",
    "android": "pnpm --filter @nico-notes/mobile android",
    "ios": "pnpm --filter @nico-notes/mobile ios",
    "dev:web": "pnpm --filter @nico-notes/web dev",
    "dev:backend": "pnpm --filter @nico-notes/backend dev",
    "build": "pnpm build:android && pnpm build:web",
    "build:android": "pnpm --filter @nico-notes/mobile build",
    "build:android:store": "node scripts/build-android-release.mjs",
    "build:web": "pnpm --filter @nico-notes/web build",
    "deploy:web": "pnpm build:web && pnpm dlx wrangler@4.151.3 pages deploy apps/web/dist --project-name nico-notes --branch main --commit-dirty=true",
    "check": "vp check && tsc --noEmit && pnpm -r typecheck",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:photos": "node --test packages/backend/scripts/local-photos.test.mjs",
    "test:navigation": "playwright test --config tests/playwright.navigation.config.ts",
    "release:check": "pnpm check && pnpm test && pnpm test:photos && pnpm build",
    "release:config": "node scripts/check-release-config.mjs",
    "format": "vp fmt",
    "deploy:backend": "pnpm --filter @nico-notes/backend deploy",
    "photos": "pnpm --filter @nico-notes/backend photos",
    "start": "node scripts/start-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "convex-test": "latest",
    "typescript": "~5.9.3",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.33.3"
}
