EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
EXPO_PUBLIC_WEB_URL=https://notes.nishitnagar.com
# OAuth client of type iOS for com.nishitnagar.notes, in the same Google Cloud
# project as the existing Web client. Public build configuration, not a secret.
GOOGLE_IOS_CLIENT_ID=
# Maps SDK for Android key, restricted to the Android package and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
# Maps SDK for iOS key, restricted to iOS bundle ID com.nishitnagar.notes.
GOOGLE_MAPS_IOS_API_KEY=
# Set after linking your own Expo/EAS project. No signing secrets belong here.
EXPO_PROJECT_ID=
# Increment for every submitted Android build.
ANDROID_VERSION_CODE=1
