VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Google Cloud: enable Maps JavaScript API and Places API (New), with billing.
# Restrict this browser key by HTTP referrer to your local and deployed app URLs.
# Allow http://localhost:5173/* and https://notes.nishitnagar.com/*.
VITE_GOOGLE_MAPS_API_KEY=
# Optional custom JavaScript map ID. Uses Google's demo map ID for local development.
VITE_GOOGLE_MAPS_MAP_ID=
