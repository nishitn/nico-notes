{
  "name": "@nico-notes/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./convex/_generated/api.js",
    "./dataModel": "./convex/_generated/dataModel.d.ts",
    "./shared": "./shared.ts",
    "./legal": "./legal.ts",
    "./livePlaces": "./livePlaces.ts",
    "./livePlaceCache": "./livePlaceCache.ts",
    "./attributions": "./attributions.ts",
    "./mapMarkers": "./mapMarkers.ts",
    "./notificationTime": "./notificationTime.ts",
    "./notificationText": "./notificationText.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "codegen": "convex codegen",
