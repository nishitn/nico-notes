+package com.swmansion.rnscreens.gamma.tabs.host
+
+import android.graphics.Color
+import android.graphics.Rect
+import android.graphics.drawable.GradientDrawable
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewConfiguration
+import android.view.accessibility.AccessibilityManager
+import android.widget.PopupWindow
+import android.widget.TextView
+import androidx.core.content.getSystemService
+import com.google.android.material.R
+import com.google.android.material.color.MaterialColors
+import java.lang.ref.WeakReference
+
+/** Keeps native tab hints centered over the tab instead of the pointer. */
+internal class CenteredTabTooltip(private val anchor: View) : View.OnAttachStateChangeListener {
+    private var text: CharSequence? = null
+    private var popup: PopupWindow? = null
+    private var pending = false
+    private val showHint = Runnable {
+        pending = false
+        show(fromTouch = false)
+    }
+    private val hideHint = Runnable { dismiss() }
+
+    init {
+        anchor.addOnAttachStateChangeListener(this)
+    }
+
+    fun bind(text: CharSequence?) {
+        this.text = text
+        anchor.setOnLongClickListener {
+            show(fromTouch = true)
+            true
+        }
+        anchor.setOnTouchListener { _, event ->
+            if (event.actionMasked == MotionEvent.ACTION_DOWN) dismiss()
+            false
+        }
+        anchor.setOnHoverListener { _, event ->
+            val accessibility = anchor.context.getSystemService<AccessibilityManager>()
+            if (accessibility?.isTouchExplorationEnabled != true && anchor.isEnabled) {
+                when (event.actionMasked) {
+                    MotionEvent.ACTION_HOVER_ENTER, MotionEvent.ACTION_HOVER_MOVE -> {
+                        if (!pending && popup == null) {
+                            pending = true
+                            anchor.postDelayed(showHint, ViewConfiguration.getLongPressTimeout().toLong())
+                        }
+                    }
+                    MotionEvent.ACTION_HOVER_EXIT -> dismiss()
+                }
+            }
+            false
+        }
+    }
+
+    private fun dp(value: Int) = (value * anchor.resources.displayMetrics.density).toInt()
+
+    private fun show(fromTouch: Boolean) {
+        dismiss()
+        if (!anchor.isAttachedToWindow || !anchor.isShown || !anchor.isEnabled || text.isNullOrBlank()) return
+        activeTooltip?.get()?.dismiss()
+        activeTooltip = WeakReference(this)
+
+        val frame = Rect()
+        anchor.getWindowVisibleDisplayFrame(frame)
+        val margin = dp(8)
+        val availableWidth = frame.width() - margin * 2
+        if (availableWidth <= 0) return
+
+        val label = TextView(anchor.context).apply {
+            text = this@CenteredTabTooltip.text
+            textSize = 14f
+            setTextColor(MaterialColors.getColor(anchor, R.attr.colorOnSurfaceInverse, Color.WHITE))
+            setPadding(dp(8), dp(4), dp(8), dp(4))
+            background = GradientDrawable().apply {
+                setColor(MaterialColors.getColor(anchor, R.attr.colorSurfaceInverse, Color.DKGRAY))
+                cornerRadius = dp(4).toFloat()
+            }
+            importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+            measure(
+                View.MeasureSpec.makeMeasureSpec(availableWidth, View.MeasureSpec.AT_MOST),
+                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
+            )
+        }
+        val location = IntArray(2)
+        anchor.getLocationOnScreen(location)
+        val left = (location[0] + (anchor.width - label.measuredWidth) / 2)
+            .coerceIn(frame.left + margin, frame.right - margin - label.measuredWidth)
+
+        popup = PopupWindow(label, label.measuredWidth, label.measuredHeight, false).apply {
+            isTouchable = false
+            isClippingEnabled = true
+            // The dropdown API keeps window insets and anchor coordinates in sync.
+            // A negative vertical offset places the hint just above the tab.
+            showAsDropDown(
+                anchor,
+                left - location[0],
+                -anchor.height - label.measuredHeight - margin,
+                Gravity.LEFT,
+            )
+        }
+        anchor.postDelayed(hideHint, if (fromTouch) 1500L else 10000L)
+    }
+
+    private fun dismiss() {
+        anchor.removeCallbacks(showHint)
+        anchor.removeCallbacks(hideHint)
+        pending = false
+        popup?.dismiss()
+        popup = null
+        if (activeTooltip?.get() === this) activeTooltip = null
+    }
+
+    override fun onViewAttachedToWindow(view: View) = Unit
+    override fun onViewDetachedFromWindow(view: View) = dismiss()
+
+    companion object {
+        private var activeTooltip: WeakReference<CenteredTabTooltip>? = null
+    }
+}
